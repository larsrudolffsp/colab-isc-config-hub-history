    "definition": {
      "start": "Get Identity",
      "steps": {
        "End Step - Success": {
          "displayName": "Workflow Complete",
          "type": "success"
        },
        "Get Identity": {
          "actionId": "sp:get-identity",
          "attributes": {
            "id.$": "$.trigger.identity.id"
          },
          "displayName": "Get Identity Details",
          "nextStep": "Send Email to Manager",
          "type": "action",
          "versionNumber": 2
        },
        "Send Email to Manager": {
          "actionId": "sp:send-email",
          "attributes": {
            "body": "A new employee has joined the organization.\n\nEmployee Name: ${identityName}\nEmployee Email: ${identityEmail}\n\nPlease ensure they have the necessary access and resources to begin their role.",
            "context": {
              "identityEmail.$": "$.getIdentity.attributes.email",
              "identityName.$": "$.getIdentity.name"
            },
            "recipientEmailList.$": "$.getIdentity.attributes.manager.email",
            "subject": "New Employee Notification - ${identityName}"
          },
          "displayName": "Notify Manager",
          "nextStep": "End Step - Success",
          "type": "action",
          "versionNumber": 2
        }
      }
    },
    "description": "Workflow that triggers when a new identity is created and sends a notification email to the manager",

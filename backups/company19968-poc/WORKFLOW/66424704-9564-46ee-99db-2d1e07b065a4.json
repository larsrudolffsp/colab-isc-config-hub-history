    },
    "name": "Service Now ticket-Initiate Onboarding Process ",
    "owner": {
      "id": "bd04981e863b4ccd9b751081eb220ddd",
      "name": "andre.hostombe",
      "type": "IDENTITY"
    },
    "trigger": {
      "attributes": {
        "filter.$": "$[?($.attributes.department == \"sales\")]",
        "id": "idn:identity-created",
        "integrationId": null
      },
      "mode": "advanced",
      "type": "EVENT"
    }
  },
  "self": {
    "id": "66424704-9564-46ee-99db-2d1e07b065a4",
    "name": "Service Now ticket-Initiate Onboarding Process ",
    "type": "WORKFLOW"
  },
